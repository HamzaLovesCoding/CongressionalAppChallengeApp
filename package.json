{
  "name": "amber-driving-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "build:test": "tsc --noEmit && VITE_SUPABASE_URL= VITE_SUPABASE_PUBLISHABLE_KEY= VITE_SUPABASE_ANON_KEY= vite build --outDir dist-test",
    "preview:test": "vite preview --host 127.0.0.1 --outDir dist-test --port 4173 --strictPort",
    "preview": "vite preview --host 0.0.0.0",
    "inspect:feed": "node scripts/inspect-feed.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.27.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
